# ---- colcon build artifacts -------------------------------------------------
# Regenerated by `colcon build`. They are machine-specific (absolute paths,
# compiled binaries) and would be useless on another computer.
build/
install/
log/

# ---- vendored upstream source ----------------------------------------------
# moveit_task_constructor is an unmodified clone of
# https://github.com/moveit/moveit_task_constructor.git
# Committing it would nest someone else's repo inside this one. See README.
moveit_task_constructor/

# ---- ad-hoc backup archives -------------------------------------------------
*.zip

# ---- local tool config ------------------------------------------------------
# Per-machine Claude Code permissions; not useful to anyone else.
**/.claude/settings.local.json

# ---- python -----------------------------------------------------------------
__pycache__/
*.py[cod]

# ---- editor / OS ------------------------------------------------------------
.vscode/
.idea/
*.swp
*~
.DS_Store
