<?xml version="1.0" ?>
<robot name="myarm_300_pi_thorgripper">

  <material name="white_arm"><color rgba="1.0 1.0 1.0 1.0"/></material>
  <material name="gray_part"><color rgba="0.5 0.5 0.5 1.0"/></material>

  <link name="world"/>
  <joint name="virtual_fixed_joint" type="fixed">
    <parent link="world"/>
    <child link="base"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base">
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="1.0"/><inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/></inertial>
    <visual><geometry><mesh filename="package://myarm_300_pi/meshes/base.stl"/></geometry><material name="white_arm"/></visual>
    <collision><geometry><mesh filename="package://myarm_300_pi/meshes/base.stl"/></geometry></collision>
  </link>

  <link name="link1">
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.5"/><inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/></inertial>
    <visual><geometry><mesh filename="package://myarm_300_pi/meshes/j1.stl"/></geometry><origin rpy="0 0 0" xyz="0 0 -0.086"/><material name="white_arm"/></visual>
    <collision><geometry><mesh filename="package://myarm_300_pi/meshes/j1.stl"/></geometry><origin rpy="0 0 0" xyz="0 0 -0.086"/></collision>
  </link>
  <joint name="joint1" type="revolute">
    <axis xyz="0 0 1"/><limit effort="1000.0" lower="-2.7925" upper="2.7925" velocity="2.0"/><parent link="base"/><child link="link1"/><origin rpy="0 0 0" xyz="0 0 0.1695"/>
  </joint>

  <link name="link2">
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.5"/><inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/></inertial>
    <visual><geometry><mesh filename="package://myarm_300_pi/meshes/j2.stl"/></geometry><origin rpy="3.14159 0 -1.5708" xyz="0 0 0"/><material name="white_arm"/></visual>
    <collision><geometry><mesh filename="package://myarm_300_pi/meshes/j2.stl"/></geometry><origin rpy="3.14159 0 -1.5708" xyz="0 0 0"/></collision>
  </link>
  <joint name="joint2" type="revolute">
    <axis xyz="0 0 1"/><limit effort="1000.0" lower="-1.2217" upper="2.0071" velocity="2.0"/><parent link="link1"/><child link="link2"/><origin rpy="-1.5708 0 0" xyz="0 0 0"/>
  </joint>

  <link name="link3">
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.5"/><inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/></inertial>
    <visual><geometry><mesh filename="package://myarm_300_pi/meshes/j3.stl"/></geometry><origin rpy="0 0 0" xyz="0 0 -0.056"/><material name="white_arm"/></visual>
    <collision><geometry><mesh filename="package://myarm_300_pi/meshes/j3.stl"/></geometry><origin rpy="0 0 0" xyz="0 0 -0.056"/></collision>
  </link>
  <joint name="joint3" type="revolute">
    <axis xyz="0 0 1"/><limit effort="1000.0" lower="-2.9670" upper="2.9670" velocity="2.0"/><parent link="link2"/><child link="link3"/><origin rpy="1.5708 0 0" xyz="0 -0.1155 0"/>
  </joint>

  <link name="link4">
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.5"/><inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/></inertial>
    <visual><geometry><mesh filename="package://myarm_300_pi/meshes/j4.stl"/></geometry><origin rpy="0 0 1.5708" xyz="0 0 0"/><material name="white_arm"/></visual>
    <collision><geometry><mesh filename="package://myarm_300_pi/meshes/j4.stl"/></geometry><origin rpy="0 0 1.5708" xyz="0 0 0"/></collision>
  </link>
  <joint name="joint4" type="revolute">
    <axis xyz="0 0 1"/><limit effort="1000.0" lower="-1.9722" upper="1.3089" velocity="2.0"/><parent link="link3"/><child link="link4"/><origin rpy="1.5708 0 0" xyz="0 0 0"/>
  </joint>

  <link name="link5">
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.5"/><inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/></inertial>
    <visual><geometry><mesh filename="package://myarm_300_pi/meshes/j5.stl"/></geometry><origin rpy="0 0 0" xyz="0 0 -0.0525"/><material name="white_arm"/></visual>
    <collision><geometry><mesh filename="package://myarm_300_pi/meshes/j5.stl"/></geometry><origin rpy="0 0 0" xyz="0 0 -0.0525"/></collision>
  </link>
  <joint name="joint5" type="revolute">
    <axis xyz="0 0 1"/><limit effort="1000.0" lower="-2.9670" upper="2.9670" velocity="2.0"/><parent link="link4"/><child link="link5"/><origin rpy="-1.5708 0 0" xyz="0 0.1278 0"/>
  </joint>

  <link name="link6">
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.5"/><inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/></inertial>
    <visual><geometry><mesh filename="package://myarm_300_pi/meshes/j6.stl"/></geometry><origin rpy="0 0 1.5708" xyz="0 0 0"/><material name="white_arm"/></visual>
    <collision><geometry><mesh filename="package://myarm_300_pi/meshes/j6.stl"/></geometry><origin rpy="0 0 1.5708" xyz="0 0 0"/></collision>
  </link>
  <joint name="joint6" type="revolute">
    <axis xyz="0 0 1"/><limit effort="1000.0" lower="-2.0071" upper="2.0071" velocity="2.0"/><parent link="link5"/><child link="link6"/><origin rpy="1.5708 0 0" xyz="0 0 0"/>
  </joint>

  <link name="link7">
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.5"/><inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/></inertial>
    <visual><geometry><mesh filename="package://myarm_300_pi/meshes/j7.stl"/></geometry><origin rpy="0 0 0" xyz="0.0002 -0.0002 -0.0185"/><material name="white_arm"/></visual>
