  </link>
  <joint name="joint7" type="revolute">
    <axis xyz="0 0 1"/><limit effort="1000.0" lower="-3.14159" upper="3.14159" velocity="2.0"/><parent link="link6"/><child link="link7"/><origin rpy="-1.5708 0 0" xyz="0 0.066 0"/>
  </joint>

  <link name="flange_link">
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.05"/><inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/></inertial>
    <visual><geometry><mesh filename="package://myarm_300_pi/meshes/flange.stl" scale="0.001 0.001 0.001"/></geometry><material name="gray_part"/></visual>
    <collision><geometry><mesh filename="package://myarm_300_pi/meshes/flange.stl" scale="0.001 0.001 0.001"/></geometry></collision>
  </link>
  <joint name="flange_joint" type="fixed">
    <parent link="link7"/><child link="flange_link"/><origin xyz="0 0 -0.001" rpy="0 0 0"/>
  </joint>

  <link name="gripper_base">
    <inertial><mass value="0.2"/><inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/></inertial>
    <visual><geometry><mesh filename="package://myarm_300_pi/meshes/GripperBase.stl" scale="0.001 0.001 0.001"/></geometry><material name="gray_part"/></visual>
    <collision><origin rpy="0 0 0" xyz="0 0 0.0275"/><geometry><box size="0.065 0.0348 0.055"/></geometry></collision>
  </link>
  <joint name="joint7_to_gripper_base" type="fixed">
    <parent link="flange_link"/><child link="gripper_base"/><origin rpy="0 0 1.5708" xyz="0 0 0.02"/>
  </joint>

  <link name="gripper_mid_point"><inertial><mass value="0.01"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial></link>
  <link name="gripper_arm_gear_right"><inertial><mass value="0.01"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial><visual><origin rpy="0 -1.57 1.57"/><geometry><mesh filename="package://myarm_300_pi/meshes/GripperArmGear.stl" scale="0.001 0.001 0.001"/></geometry><material name="gray_part"/></visual><collision><origin xyz="0.0175 -0.0025 0.0"/><geometry><box size="0.035 0.005 0.004"/></geometry></collision></link>
  <link name="gripper_arm_gear_left"><inertial><mass value="0.01"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial><visual><origin rpy="0 1.57 -1.57"/><geometry><mesh filename="package://myarm_300_pi/meshes/GripperArmGear.stl" scale="0.001 0.001 0.001"/></geometry><material name="gray_part"/></visual><collision><origin xyz="-0.0175 -0.0025 0.0"/><geometry><box size="0.035 0.005 0.004"/></geometry></collision></link>
  <link name="gripper_arm_simple_right"><inertial><mass value="0.01"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial><visual><origin rpy="0 -1.57 1.57"/><geometry><mesh filename="package://myarm_300_pi/meshes/GripperArm.stl" scale="0.001 0.001 0.001"/></geometry><material name="gray_part"/></visual><collision><origin xyz="0.0175 -0.0025 0.0"/><geometry><box size="0.035 0.005 0.004"/></geometry></collision></link>
  <link name="gripper_arm_simple_left"><inertial><mass value="0.01"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial><visual><origin rpy="0 1.57 -1.57"/><geometry><mesh filename="package://myarm_300_pi/meshes/GripperArm.stl" scale="0.001 0.001 0.001"/></geometry><material name="gray_part"/></visual><collision><origin xyz="-0.0175 -0.0025 0.0"/><geometry><box size="0.035 0.005 0.004"/></geometry></collision></link>
  <link name="gripper_finger_right"><inertial><mass value="0.01"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial><visual><origin rpy="0 0 0" xyz="0 0 0"/><geometry><mesh filename="package://myarm_300_pi/meshes/GripperFinger.stl" scale="0.001 0.001 0.001"/></geometry><material name="gray_part"/></visual><collision><origin xyz="0.00525 0.026 0.00775"/><geometry><box size="0.0185 0.06 0.0155"/></geometry></collision></link>
  <link name="gripper_finger_left"><inertial><mass value="0.01"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial><visual><origin rpy="0 0 0" xyz="0 0 0"/><geometry><mesh filename="package://myarm_300_pi/meshes/GripperFinger.stl" scale="0.001 0.001 0.001"/></geometry><material name="gray_part"/></visual><collision><origin xyz="0.00525 0.026 0.00775"/><geometry><box size="0.0185 0.06 0.0155"/></geometry></collision></link>
  <link name="endeffector"><inertial><mass value="0.01"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial></link>

  <joint name="gripperbase_to_midpoint" type="fixed"><parent link="gripper_base"/><child link="gripper_mid_point"/><origin rpy="0 0 0" xyz="0 0 0.075"/></joint>
  <joint name="link7_to_endeffector" type="fixed"><parent link="link7"/><child link="endeffector"/><origin rpy="0 0 0" xyz="0 0 0.1"/></joint>

  <joint name="endeffector_gripper" type="revolute">
    <parent link="gripper_base"/><child link="gripper_arm_gear_right"/><origin rpy="0 0 0" xyz="0.0145 0.00275 0.0325"/><axis xyz="0 1 0"/><limit effort="4.0" lower="-1.57" upper="0" velocity="1.0"/>
  </joint>

  <joint name="gripperbase_to_armgearleft" type="revolute">
    <parent link="gripper_base"/><child link="gripper_arm_gear_left"/><origin rpy="0 0 0" xyz="-0.0145 0.00275 0.0325"/><axis xyz="0 1 0"/><limit effort="4.0" lower="0" upper="1.57" velocity="1.0"/><mimic joint="endeffector_gripper" multiplier="-1"/>
  </joint>

  <joint name="gripperbase_to_armsimpleright" type="revolute">
    <parent link="gripper_base"/><child link="gripper_arm_simple_right"/><origin rpy="0 0 0" xyz="0.006 0.00275 0.051"/><axis xyz="0 1 0"/><limit effort="4.0" lower="-1.57" upper="0" velocity="1.0"/><mimic joint="endeffector_gripper" multiplier="1"/>
  </joint>

  <joint name="gripperbase_to_armsimpleleft" type="revolute">
    <parent link="gripper_base"/><child link="gripper_arm_simple_left"/><origin rpy="0 0 0" xyz="-0.006 0.00275 0.051"/><axis xyz="0 1 0"/><limit effort="4.0" lower="0" upper="1.57" velocity="1.0"/><mimic joint="endeffector_gripper" multiplier="-1"/>
  </joint>

  <joint name="armgearright_to_fingerright" type="revolute">
    <parent link="gripper_arm_gear_right"/><child link="gripper_finger_right"/><origin rpy="-1.57 3.14 0" xyz="0.035 -0.01023 0"/><axis xyz="0 0 1"/><limit effort="4.0" lower="0" upper="1.57" velocity="1.0"/><mimic joint="endeffector_gripper" multiplier="-1"/>
  </joint>

  <joint name="armgearleft_to_fingerleft" type="revolute">
