<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="myarm_300_pi_thorgripper">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import myarm_300_pi_thorgripper urdf file -->
    <xacro:include filename="$(find myarm_300_pi)/urdf/myarm_300_pi_thorgripper.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="myarm_300_pi_thorgripper.ros2_control.xacro" />


    <xacro:myarm_300_pi_thorgripper_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
